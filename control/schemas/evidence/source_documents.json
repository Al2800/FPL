{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/source_documents.json",
  "title": "Source document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "source_id",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content_hash_sha256": {
      "type": "string"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
