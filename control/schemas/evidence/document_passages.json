{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/document_passages.json",
  "title": "Document passage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passage_id",
    "document_id",
    "text",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "passage_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
