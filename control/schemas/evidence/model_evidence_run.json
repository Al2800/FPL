{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/model_evidence_run.json",
  "title": "Model evidence run",
  "description": "Structured output from an engine model's official-source research run. The host validates and admits eligible claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "model",
    "prompt",
    "observed_at",
    "available_at",
    "bound_packet_sha256",
    "discovery_sha256",
    "scope",
    "coverage",
    "claims",
    "decision_trace"
  ],
  "properties": {
    "schema_version": {
      "const": "model-evidence-run-v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "available_at": {
      "type": "string",
      "format": "date-time"
    },
    "bound_packet_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "discovery_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogue_sha256",
        "searched_club_ids",
        "watchlist_player_uids",
        "watchlist_basis"
      ],
      "properties": {
        "catalogue_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "searched_club_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "watchlist_player_uids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "watchlist_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "lead_count"
        ],
        "properties": {
          "status": {
            "enum": [
              "complete",
              "empty",
              "error",
              "not_attempted"
            ]
          },
          "lead_count": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "club_id",
          "player_uid",
          "source_id",
          "source_url",
          "source_title",
          "claim_text",
          "why_relevant",
          "claim_type",
          "status",
          "confidence",
          "published_at",
          "expires_at"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "club_id": {
            "type": "string",
            "minLength": 1
          },
          "player_uid": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://",
            "minLength": 12
          },
          "source_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "claim_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "why_relevant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "claim_type": {
            "enum": [
              "availability",
              "minutes_role",
              "lineup"
            ]
          },
          "status": {
            "enum": [
              "unavailable",
              "doubtful",
              "available"
            ]
          },
          "recovery_condition": {
            "enum": [
              "declared_fit",
              "returned_to_training",
              "started_match"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "decision_boundary_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "estimated_impact_points": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "decision_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boundary_id",
          "decision",
          "rationale",
          "alternatives_rejected",
          "supporting_claim_ids",
          "conflicting_claim_ids",
          "confidence",
          "falsifiers"
        ],
        "properties": {
          "boundary_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "alternatives_rejected": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "supporting_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conflicting_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "falsifiers": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    }
  }
}
