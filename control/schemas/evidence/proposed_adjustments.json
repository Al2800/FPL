{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/proposed_adjustments.json",
  "title": "Proposed adjustment",
  "description": "A controlled, cited change proposed to a forecast assumption. Agents may propose; they must not apply.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adjustment_id",
    "signal_ids",
    "target",
    "before_value",
    "after_value",
    "status",
    "confidence",
    "expires_at",
    "published_at",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "adjustment_id": {
      "type": "string"
    },
    "signal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "player_uid": {
      "type": "string"
    },
    "target": {
      "type": "string",
      "description": "Forecast field being adjusted",
      "enum": [
        "start_probability",
        "expected_minutes",
        "expected_points",
        "availability_flag"
      ]
    },
    "before_value": {
      "type": [
        "number",
        "string",
        "boolean"
      ]
    },
    "after_value": {
      "type": [
        "number",
        "string",
        "boolean"
      ]
    },
    "unit": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "expired"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string"
    },
    "expires_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
