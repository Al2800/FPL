{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/claim_conflicts.json",
  "title": "Claim conflict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conflict_id",
    "claim_ids",
    "description",
    "status",
    "provenance"
  ],
  "properties": {
    "conflict_id": {
      "type": "string"
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "description": {
      "type": "string"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    },
    "status": {
      "type": "string",
      "enum": [
        "unresolved",
        "resolved"
      ]
    },
    "resolution_outcome": {
      "type": "string",
      "enum": [
        "dismissed",
        "confidence_downgrade",
        "forced_re_run",
        "escalation"
      ]
    },
    "resolved_by_review_id": {
      "type": "string"
    },
    "resolution_notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "required": [
          "resolution_outcome",
          "resolved_by_review_id",
          "resolution_notes"
        ]
      }
    }
  ]
}
