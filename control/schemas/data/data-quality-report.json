{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-agent-lab.local/schemas/data/data-quality-report.json",
  "title": "Data-quality gate report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version", "report_id", "policy_version", "mode", "source_id",
    "snapshot_id", "evaluated_at", "required_source", "recommended_disposition",
    "enforced_disposition", "admissible", "checks", "metrics", "quarantine",
    "admitted_observation_ids", "degraded_capabilities", "disagreements"
  ],
  "properties": {
    "report_version": {"const": "1.0"},
    "report_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "mode": {"enum": ["observe_only", "shadow", "enforce"]},
    "source_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "required_source": {"type": "boolean"},
    "recommended_disposition": {"$ref": "#/$defs/disposition"},
    "enforced_disposition": {"$ref": "#/$defs/disposition"},
    "admissible": {"type": "boolean"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "category", "status", "scope", "recommended_disposition", "enforcement_enabled", "reason_code", "observed", "threshold", "targets", "details"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "category": {"enum": ["acquisition", "schema", "freshness", "coverage", "duplicates", "identity", "disagreement"]},
          "status": {"enum": ["pass", "warn", "fail"]},
          "scope": {"$ref": "#/$defs/scope"},
          "recommended_disposition": {"$ref": "#/$defs/disposition"},
          "enforcement_enabled": {"type": "boolean"},
          "reason_code": {"type": "string", "minLength": 1},
          "observed": {},
          "threshold": {},
          "targets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "details": {"type": "object"}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "admitted_record_count", "quarantined_record_count", "deduplicated_record_count", "schema_error_count", "schema_error_rate", "exact_duplicate_count", "exact_duplicate_rate", "equivalent_duplicate_count", "equivalent_duplicate_rate", "conflicting_duplicate_count", "conflicting_duplicate_rate", "coverage_rate", "identity_match_rate", "staleness_seconds", "reconciliation_count", "disagreement_count", "disagreement_rate"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "admitted_record_count": {"type": "integer", "minimum": 0},
        "quarantined_record_count": {"type": "integer", "minimum": 0},
        "deduplicated_record_count": {"type": "integer", "minimum": 0},
        "schema_error_count": {"type": "integer", "minimum": 0},
        "schema_error_rate": {"type": "number", "minimum": 0},
        "exact_duplicate_count": {"type": "integer", "minimum": 0},
        "exact_duplicate_rate": {"type": "number", "minimum": 0},
        "equivalent_duplicate_count": {"type": "integer", "minimum": 0},
        "equivalent_duplicate_rate": {"type": "number", "minimum": 0},
        "conflicting_duplicate_count": {"type": "integer", "minimum": 0},
        "conflicting_duplicate_rate": {"type": "number", "minimum": 0},
        "coverage_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "identity_match_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "staleness_seconds": {"type": ["number", "null"]},
        "reconciliation_count": {"type": "integer", "minimum": 0},
        "disagreement_count": {"type": "integer", "minimum": 0},
        "disagreement_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "quarantine": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "reason_code", "targets", "enforced"],
        "properties": {
          "scope": {"$ref": "#/$defs/scope"},
          "reason_code": {"type": "string", "minLength": 1},
          "targets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "enforced": {"type": "boolean"}
        }
      }
    },
    "admitted_observation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "degraded_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "field_name", "claims"],
        "properties": {
          "entity_id": {"type": "string"},
          "field_name": {"type": "string"},
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "observation_id", "value"],
              "properties": {
                "source_id": {"type": "string"},
                "observation_id": {"type": "string"},
                "value": {}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "disposition": {"enum": ["pass", "degrade", "quarantine", "stop"]},
    "scope": {"enum": ["record", "partition", "snapshot", "episode"]}
  }
}
