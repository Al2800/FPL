{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/approvals.json",
  "title": "Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "proposal_id",
    "approver",
    "decision",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "approver": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "deferred"
      ]
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
