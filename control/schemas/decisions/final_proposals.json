{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/final_proposals.json",
  "title": "Final proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "gameweek",
    "plan_id",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "proposal_id": {
      "type": "string"
    },
    "gameweek": {
      "type": "integer"
    },
    "plan_id": {
      "type": "string"
    },
    "decision_record_path": {
      "type": "string"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
