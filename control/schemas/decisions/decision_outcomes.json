{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/decision_outcomes.json",
  "title": "Decision outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome_id",
    "proposal_id",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "outcome_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "points": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "counterfactual_type",
        "episode_id",
        "evaluated_plan",
        "baseline_plan",
        "scoring_provenance"
      ],
      "properties": {
        "basis": {
          "const": "realised_feasible_counterfactual"
        },
        "counterfactual_type": {
          "enum": [
            "do_nothing",
            "captain",
            "transfer",
            "bench",
            "chip",
            "policy_arm"
          ]
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "evaluated_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_id",
            "plan_sha256"
          ],
          "properties": {
            "plan_id": {
              "type": "string",
              "minLength": 1
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "baseline_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_id",
            "plan_sha256"
          ],
          "properties": {
            "plan_id": {
              "type": "string",
              "minLength": 1
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "scoring_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_outcome_sha256",
            "ruleset_sha256"
          ],
          "properties": {
            "source_outcome_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "ruleset_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
