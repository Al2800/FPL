{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/decision_outcomes.json",
  "title": "Decision outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome_id",
    "proposal_id",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "outcome_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "points": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
