{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/player_projections.json",
  "title": "Player projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "player_uid",
    "expected_points",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "player_uid": {
      "type": "string"
    },
    "expected_points": {
      "type": "number"
    },
    "expected_minutes": {
      "type": "number"
    },
    "start_probability": {
      "type": "number"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
