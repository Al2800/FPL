{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/gameweek_decision_records.json",
  "title": "Gameweek Decision Record",
  "description": "Auditable per-Gameweek output capturing every element in plan Sections 3.1 and 16.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_id",
    "gameweek",
    "season",
    "decision_cutoff",
    "deadline",
    "ruleset_id",
    "manager_state",
    "recommendation",
    "baseline_comparison",
    "validation",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "record_id": { "type": "string" },
    "gameweek": { "type": "integer" },
    "season": { "type": "string" },
    "fixture_id": { "type": "string" },
    "decision_cutoff": { "$ref": "../_defs.json#/$defs/iso_datetime" },
    "deadline": { "$ref": "../_defs.json#/$defs/iso_datetime" },
    "ruleset_id": { "type": "string" },
    "data_quality": { "type": "string" },
    "degraded": { "type": "boolean" },
    "manager_state": {
      "type": "object",
      "required": ["bank", "free_transfers"],
      "properties": {
        "bank": { "type": "number" },
        "free_transfers": { "type": "integer" },
        "chips_available": {
          "type": "array",
          "items": { "type": "string" }
        },
        "squad_player_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "projections_summary": {
      "type": "object",
      "properties": {
        "n_players": { "type": "integer" },
        "model_versions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "principal_uncertainty": { "type": "string" }
      }
    },
    "candidate_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["strategy", "objective"],
        "properties": {
          "strategy": { "type": "string" },
          "objective": { "type": "number" },
          "hit_cost": { "type": "integer" },
          "transfers": { "type": "array" }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["strategy", "lineup"],
      "properties": {
        "strategy": { "type": "string" },
        "transfers": { "type": "array" },
        "hit_cost": { "type": "integer" },
        "chip": { "type": ["string", "null"] },
        "captain_name": { "type": "string" },
        "vice_captain_name": { "type": "string" },
        "lineup": { "type": "object" }
      }
    },
    "baseline_comparison": {
      "type": "object",
      "required": ["do_nothing_objective", "recommended_objective", "expected_advantage"],
      "properties": {
        "do_nothing_objective": { "type": "number" },
        "recommended_objective": { "type": "number" },
        "expected_advantage": { "type": "number" },
        "notes": { "type": "string" }
      }
    },
    "alternatives": {
      "type": "object",
      "properties": {
        "conservative": { "type": ["object", "null"] },
        "aggressive": { "type": ["object", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "supporting_claim_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conflicting_claim_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conflict_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "proposed_adjustment_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "validation": { "type": "object" },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "deferred"]
        },
        "approver": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["manual", "dry_run", "automated"]
        },
        "notes": { "type": "string" }
      }
    },
    "outcome": {
      "type": ["object", "null"],
      "properties": {
        "points": { "type": "number" },
        "notes": { "type": "string" },
        "finalised_at": { "$ref": "../_defs.json#/$defs/iso_datetime" }
      }
    },
    "retrospective": {
      "type": ["object", "null"],
      "properties": {
        "process_notes": { "type": "string" },
        "lessons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metrics": { "type": "object" }
      }
    },
    "confidence": { "type": "string" },
    "principal_uncertainty": { "type": "string" },
    "pipeline": { "type": "object" },
    "repro_hash": { "type": "string" },
    "published_at": { "$ref": "../_defs.json#/$defs/iso_datetime" },
    "observed_at": { "$ref": "../_defs.json#/$defs/iso_datetime" },
    "effective_at": { "$ref": "../_defs.json#/$defs/iso_datetime" },
    "finalised_at": { "$ref": "../_defs.json#/$defs/iso_datetime" },
    "available_at": { "$ref": "../_defs.json#/$defs/iso_datetime" },
    "provenance": { "$ref": "../_defs.json#/$defs/provenance" }
  }
}
