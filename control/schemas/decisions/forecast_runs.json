{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/forecast_runs.json",
  "title": "Forecast run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "model_version",
    "deadline",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "deadline": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
