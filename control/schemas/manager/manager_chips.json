{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/manager_chips.json",
  "title": "Manager chip state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manager_id",
    "season_id",
    "chip",
    "status",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "manager_id": {
      "type": "string"
    },
    "season_id": {
      "type": "string"
    },
    "chip": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "used_gameweek": {
      "type": [
        "integer",
        "null"
      ]
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
