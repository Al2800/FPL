{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/manager_transfers.json",
  "title": "Manager transfer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transfer_id",
    "manager_id",
    "player_in_uid",
    "player_out_uid",
    "gameweek",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "transfer_id": {
      "type": "string"
    },
    "manager_id": {
      "type": "string"
    },
    "player_in_uid": {
      "type": "string"
    },
    "player_out_uid": {
      "type": "string"
    },
    "gameweek": {
      "type": "integer"
    },
    "cost": {
      "type": "integer"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
