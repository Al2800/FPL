{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/manager_finance.json",
  "title": "Manager finance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manager_id",
    "bank",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "manager_id": {
      "type": "string"
    },
    "bank": {
      "$ref": "../_defs.json#/$defs/money"
    },
    "team_value": {
      "$ref": "../_defs.json#/$defs/money"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
