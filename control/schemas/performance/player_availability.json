{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/player_availability.json",
  "title": "Player availability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "player_uid",
    "status",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "player_uid": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "expires_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "supersedes_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "condition_met"
      ],
      "properties": {
        "condition": {
          "type": "string",
          "enum": [
            "declared_fit",
            "returned_to_training",
            "started_match"
          ]
        },
        "condition_met": {
          "const": true
        }
      }
    },
    "chance_of_playing": {
      "type": [
        "number",
        "null"
      ]
    },
    "news": {
      "type": "string"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
