{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/player_match_stats.json",
  "title": "Player match stats",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "player_uid",
    "fixture_uid",
    "minutes",
    "position",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "player_uid": {
      "type": "string"
    },
    "fixture_uid": {
      "type": "string"
    },
    "minutes": {
      "type": "integer"
    },
    "goals": {
      "type": "integer"
    },
    "assists": {
      "type": "integer"
    },
    "clean_sheet": {
      "type": "boolean"
    },
    "saves": {
      "type": "integer"
    },
    "goals_conceded": {
      "type": "integer"
    },
    "yellow_cards": {
      "type": "integer"
    },
    "red_cards": {
      "type": "integer"
    },
    "own_goals": {
      "type": "integer"
    },
    "penalty_misses": {
      "type": "integer"
    },
    "penalty_saves": {
      "type": "integer"
    },
    "defensive_actions": {
      "type": "integer"
    },
    "bps": {
      "type": "integer"
    },
    "bonus": {
      "type": "integer"
    },
    "total_points": {
      "type": "integer"
    },
    "position": {
      "$ref": "../_defs.json#/$defs/position"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
