{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/player_match_events.json",
  "title": "Player match event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "player_uid",
    "fixture_uid",
    "event_type",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "player_uid": {
      "type": "string"
    },
    "fixture_uid": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "minute": {
      "type": "integer"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
