{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/player_gameweek_stats.json",
  "title": "Player gameweek stats",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "player_uid",
    "season_id",
    "gameweek",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "player_uid": {
      "type": "string"
    },
    "season_id": {
      "type": "string"
    },
    "gameweek": {
      "type": "integer"
    },
    "total_points": {
      "type": "integer"
    },
    "minutes": {
      "type": "integer"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
