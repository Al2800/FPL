{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/team_match_stats.json",
  "title": "Team match stats",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "team_uid",
    "fixture_uid",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "team_uid": {
      "type": "string"
    },
    "fixture_uid": {
      "type": "string"
    },
    "goals_for": {
      "type": "integer"
    },
    "goals_against": {
      "type": "integer"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
