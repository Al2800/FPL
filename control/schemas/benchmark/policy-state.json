{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/benchmark/policy-state.json",
  "title": "Longitudinal benchmark policy state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "status",
    "origin",
    "policy_arm",
    "season",
    "gameweek",
    "ruleset_id",
    "ruleset_sha256",
    "previous_state_sha256",
    "transition_id",
    "squad",
    "bank",
    "free_transfers",
    "chips_available",
    "chip_history",
    "cumulative_points",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "state_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,191}$"},
    "status": {"enum": ["active", "season_complete"]},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "seed_id", "seed_sha256"],
      "properties": {
        "type": {"const": "controlled_shared_seed"},
        "seed_id": {"type": "string", "minLength": 3},
        "seed_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy_arm": {"$ref": "#/$defs/policy_arm"},
    "season": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "gameweek": {"type": "integer", "minimum": 1, "maximum": 99},
    "ruleset_id": {"type": "string", "minLength": 1},
    "ruleset_sha256": {"$ref": "#/$defs/sha256"},
    "previous_state_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "transition_id": {"type": ["string", "null"], "minLength": 3},
    "squad": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/player"}
    },
    "club_limit_exceptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/club_limit_exception"}
    },
    "bank": {"type": "number", "minimum": 0},
    "free_transfers": {"type": "integer", "minimum": 0, "maximum": 99},
    "chips_available": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/chip"}
    },
    "chip_history": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chip", "gameweek"],
        "properties": {
          "chip": {"$ref": "#/$defs/chip"},
          "gameweek": {"type": "integer", "minimum": 1, "maximum": 98}
        }
      }
    },
    "cumulative_points": {"type": "integer"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_arm": {
      "enum": [
        "naive_baseline",
        "forecast_optimizer",
        "evidence_agent",
        "evidence_challenger",
        "human_decision"
      ]
    },
    "chip": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_(fh|sh)$"},
    "club_limit_exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "club_id",
        "player_count",
        "maximum",
        "reason",
        "must_resolve_when_next_transfer_made"
      ],
      "properties": {
        "club_id": {"type": "string", "minLength": 1},
        "player_count": {"type": "integer", "minimum": 4},
        "maximum": {"type": "integer", "minimum": 1},
        "reason": {
          "const": "player_transferred_between_premier_league_clubs"
        },
        "must_resolve_when_next_transfer_made": {"const": true}
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_id",
        "position",
        "club_id",
        "purchase_price",
        "current_price",
        "selling_price"
      ],
      "properties": {
        "player_id": {"type": "string", "minLength": 1},
        "position": {"enum": ["GKP", "DEF", "MID", "FWD"]},
        "club_id": {"type": "string", "minLength": 1},
        "purchase_price": {"type": "number", "minimum": 0},
        "current_price": {"type": "number", "minimum": 0},
        "selling_price": {"type": "number", "minimum": 0}
      }
    }
  }
}
