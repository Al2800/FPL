{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl.local/schemas/benchmark/validated-plan.json",
  "title": "Canonical validated Gameweek plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "episode_id",
    "policy_arm",
    "season",
    "gameweek",
    "previous_state_sha256",
    "ruleset",
    "transfers",
    "squad_after",
    "lineup",
    "active_chip",
    "finance",
    "validation",
    "frozen_at",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "policy_arm": {"type": "string", "minLength": 1},
    "season": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "gameweek": {"type": "integer", "minimum": 1, "maximum": 38},
    "previous_state_sha256": {"$ref": "#/$defs/sha256"},
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleset_id", "content_sha256"],
      "properties": {
        "ruleset_id": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "transfers": {
      "type": "array",
      "items": {"$ref": "#/$defs/transfer"}
    },
    "squad_after": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/player"}
    },
    "lineup": {"$ref": "#/$defs/lineup"},
    "active_chip": {
      "type": ["string", "null"],
      "enum": [
        null,
        "wildcard_fh",
        "free_hit_fh",
        "triple_captain_fh",
        "bench_boost_fh",
        "wildcard_sh",
        "free_hit_sh",
        "triple_captain_sh",
        "bench_boost_sh"
      ]
    },
    "finance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bank_before",
        "bank_after",
        "free_transfers_before",
        "transfer_count",
        "hit_cost"
      ],
      "properties": {
        "bank_before": {"type": "number", "minimum": 0},
        "bank_after": {"type": "number", "minimum": 0},
        "free_transfers_before": {"type": "integer", "minimum": 0},
        "transfer_count": {"type": "integer", "minimum": 0},
        "hit_cost": {"type": "integer", "minimum": 0}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks", "content_sha256"],
      "properties": {
        "status": {"const": "passed"},
        "checks": {
          "type": "array",
          "minItems": 5,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "frozen_at": {"type": "string", "format": "date-time"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_id", "position", "club_id"],
      "properties": {
        "player_id": {"type": "string", "minLength": 1},
        "position": {"enum": ["GKP", "DEF", "MID", "FWD"]},
        "club_id": {"type": "string", "minLength": 1}
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_out_id",
        "player_in_id",
        "position",
        "selling_price",
        "purchase_price"
      ],
      "properties": {
        "player_out_id": {"type": "string", "minLength": 1},
        "player_in_id": {"type": "string", "minLength": 1},
        "position": {"enum": ["GKP", "DEF", "MID", "FWD"]},
        "selling_price": {"type": "number", "minimum": 0},
        "purchase_price": {"type": "number", "minimum": 0}
      }
    },
    "lineup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formation",
        "starting_xi_ids",
        "bench_ids",
        "captain_id",
        "vice_captain_id"
      ],
      "properties": {
        "formation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["DEF", "MID", "FWD"],
          "properties": {
            "DEF": {"type": "integer", "minimum": 3, "maximum": 5},
            "MID": {"type": "integer", "minimum": 2, "maximum": 5},
            "FWD": {"type": "integer", "minimum": 1, "maximum": 3}
          }
        },
        "starting_xi_ids": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "bench_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "captain_id": {"type": "string", "minLength": 1},
        "vice_captain_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
