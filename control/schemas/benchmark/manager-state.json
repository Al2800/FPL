{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/benchmark/manager-state.json",
  "title": "Normalised manual FPL manager state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manager_state_version", "manager_state_id", "manager_id", "season",
    "gameweek", "observed_at", "available_at", "cutoff", "deadline",
    "ruleset_id", "ruleset_sha256", "bank", "free_transfers",
    "chips_available", "chip_history", "squad", "team_purchase_value",
    "team_current_value", "team_selling_value", "funds_available",
    "provenance", "content_sha256"
  ],
  "properties": {
    "manager_state_version": {"const": "1.0"},
    "manager_state_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,191}$"},
    "manager_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "season": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "gameweek": {"type": "integer", "minimum": 1, "maximum": 99},
    "observed_at": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "cutoff": {"type": "string", "format": "date-time"},
    "deadline": {"type": "string", "format": "date-time"},
    "ruleset_id": {"type": "string", "minLength": 1},
    "ruleset_sha256": {"$ref": "#/$defs/sha256"},
    "bank": {"type": "number", "minimum": 0, "multipleOf": 0.1},
    "free_transfers": {"type": "integer", "minimum": 0},
    "chips_available": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_(fh|sh)$"}
    },
    "chip_history": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["chip", "gameweek"],
        "properties": {
          "chip": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_(fh|sh)$"},
          "gameweek": {"type": "integer", "minimum": 1, "maximum": 98}
        }
      }
    },
    "squad": {
      "type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true,
      "items": {"$ref": "#/$defs/player"}
    },
    "team_purchase_value": {"type": "number", "minimum": 0},
    "team_current_value": {"type": "number", "minimum": 0},
    "team_selling_value": {"type": "number", "minimum": 0},
    "funds_available": {"type": "number", "minimum": 0},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_method", "authentication", "account_identifier_stored"],
      "properties": {
        "entry_method": {"const": "manual"},
        "authentication": {"const": "none"},
        "account_identifier_stored": {"const": false}
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "player": {
      "type": "object", "additionalProperties": false,
      "required": [
        "player_id", "fpl_code", "web_name", "position", "club_id",
        "purchase_price", "current_price", "selling_price"
      ],
      "properties": {
        "player_id": {"type": "string", "minLength": 1},
        "fpl_code": {"type": "integer", "minimum": 1},
        "web_name": {"type": "string", "minLength": 1},
        "position": {"enum": ["GKP", "DEF", "MID", "FWD"]},
        "club_id": {"type": "string", "minLength": 1},
        "purchase_price": {"type": "number", "minimum": 0},
        "current_price": {"type": "number", "minimum": 0},
        "selling_price": {"type": "number", "minimum": 0}
      }
    }
  }
}
