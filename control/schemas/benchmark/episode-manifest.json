{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/benchmark/episode-manifest.json",
  "title": "Benchmark episode manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "season",
    "gameweek",
    "mode",
    "cutoff",
    "deadline",
    "created_at",
    "code_commit",
    "ruleset",
    "observed",
    "allowed_tools",
    "resource_budget",
    "policy_arms",
    "hidden_outcome_ref"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "episode_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "season": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "gameweek": {"type": "integer", "minimum": 1, "maximum": 38},
    "mode": {
      "enum": ["historical_structured", "live_shadow", "live_cohort"]
    },
    "cutoff": {"type": "string", "format": "date-time"},
    "deadline": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "code_commit": {"$ref": "#/$defs/git_commit"},
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleset_id", "content_sha256"],
      "properties": {
        "ruleset_id": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_ids",
        "source_artifacts",
        "manager_state_ref",
        "feature_snapshot_ref",
        "forecast_uncertainty_ref"
      ],
      "properties": {
        "snapshot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/observed_artifact"}
        },
        "manager_state_ref": {"$ref": "#/$defs/artifact_ref"},
        "feature_snapshot_ref": {"$ref": "#/$defs/artifact_ref"},
        "forecast_uncertainty_ref": {"$ref": "#/$defs/artifact_ref"}
      }
    },
    "allowed_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "version", "access"],
        "properties": {
          "tool_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "access": {"enum": ["read_only", "propose_only"]}
        }
      }
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_seconds", "tool_calls", "tokens", "cost_currency", "cost_cap"],
      "properties": {
        "wall_clock_seconds": {"type": "integer", "minimum": 1},
        "tool_calls": {"type": "integer", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "cost_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "cost_cap": {"type": "number", "minimum": 0}
      }
    },
    "policy_arms": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/policy_arm"}
    },
    "hidden_outcome_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_id", "content_sha256", "reveal_after"],
      "properties": {
        "outcome_id": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "reveal_after": {"const": "proposal_frozen"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "git_commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "policy_arm": {
      "enum": [
        "naive_baseline",
        "forecast_optimizer",
        "evidence_agent",
        "evidence_challenger",
        "human_decision"
      ]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "observed_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "artifact_id", "content_sha256", "available_at"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "available_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
