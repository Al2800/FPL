{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/benchmark/run-manifest.json",
  "title": "Benchmark run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_manifest_id",
    "episode_id",
    "observed_episode_sha256",
    "created_at",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_manifest_id": {
      "type": "string",
      "minLength": 3
    },
    "episode_id": {
      "type": "string",
      "minLength": 3
    },
    "observed_episode_sha256": {
      "$ref": "#sha256"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "policy_arm",
          "agent_run_ref",
          "input_sha256",
          "output_sha256",
          "execution_status"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 3
          },
          "policy_arm": {
            "enum": [
              "evidence_agent",
              "evidence_challenger"
            ]
          },
          "agent_run_ref": {
            "$ref": "#artifact_ref"
          },
          "input_sha256": {
            "$ref": "#sha256"
          },
          "output_sha256": {
            "$ref": "#sha256"
          },
          "execution_status": {
            "enum": [
              "completed",
              "degraded",
              "failed"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "$anchor": "sha256"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "content_sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "$ref": "#sha256"
        }
      },
      "$anchor": "artifact_ref"
    }
  }
}
