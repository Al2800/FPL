{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/benchmark/state-transition.json",
  "title": "Auditable benchmark policy-state transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "policy_arm",
    "season",
    "gameweek_from",
    "gameweek_to",
    "episode_id",
    "ruleset_id",
    "ruleset_sha256",
    "previous_state_sha256",
    "proposal_sha256",
    "proposal_frozen_at",
    "outcome_id",
    "outcome_revealed_at",
    "moves",
    "active_chip",
    "temporary_squad_sha256",
    "hit_cost",
    "gross_points",
    "net_points",
    "next_state_sha256",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "transition_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,191}$"},
    "policy_arm": {"$ref": "#/$defs/policy_arm"},
    "season": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "gameweek_from": {"type": "integer", "minimum": 1, "maximum": 98},
    "gameweek_to": {"type": "integer", "minimum": 2, "maximum": 99},
    "episode_id": {"type": "string", "minLength": 3},
    "ruleset_id": {"type": "string", "minLength": 1},
    "ruleset_sha256": {"$ref": "#/$defs/sha256"},
    "previous_state_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_frozen_at": {"type": "string", "format": "date-time"},
    "outcome_id": {"type": "string", "minLength": 3},
    "outcome_revealed_at": {"type": "string", "format": "date-time"},
    "moves": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "player_out_id",
          "player_in_id",
          "position",
          "selling_price",
          "purchase_price"
        ],
        "properties": {
          "player_out_id": {"type": "string", "minLength": 1},
          "player_in_id": {"type": "string", "minLength": 1},
          "position": {"enum": ["GKP", "DEF", "MID", "FWD"]},
          "selling_price": {"type": "number", "minimum": 0},
          "purchase_price": {"type": "number", "minimum": 0}
        }
      }
    },
    "active_chip": {
      "oneOf": [{"$ref": "#/$defs/chip"}, {"type": "null"}]
    },
    "temporary_squad_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "hit_cost": {"type": "integer", "minimum": 0, "multipleOf": 4},
    "gross_points": {"type": "integer"},
    "net_points": {"type": "integer"},
    "next_club_limit_exceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/club_limit_exception"}
    },
    "next_state_sha256": {"$ref": "#/$defs/sha256"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_arm": {
      "enum": [
        "naive_baseline",
        "forecast_optimizer",
        "evidence_agent",
        "evidence_challenger",
        "human_decision"
      ]
    },
    "chip": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_(fh|sh)$"}
    ,
    "club_limit_exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "club_id",
        "player_count",
        "maximum",
        "reason",
        "must_resolve_when_next_transfer_made"
      ],
      "properties": {
        "club_id": {"type": "string", "minLength": 1},
        "player_count": {"type": "integer", "minimum": 4},
        "maximum": {"type": "integer", "minimum": 1},
        "reason": {
          "const": "player_transferred_between_premier_league_clubs"
        },
        "must_resolve_when_next_transfer_made": {"const": true}
      }
    }
  }
}
