{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/player_team_history.json",
  "title": "Player club tenure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "player_uid",
    "team_uid",
    "joined_at",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "player_uid": {
      "type": "string"
    },
    "team_uid": {
      "type": "string"
    },
    "joined_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "left_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
