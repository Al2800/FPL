{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/gameweeks.json",
  "title": "Gameweek",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "season_id",
    "gameweek",
    "deadline",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "season_id": {
      "type": "string"
    },
    "gameweek": {
      "type": "integer",
      "minimum": 1
    },
    "deadline": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "is_current": {
      "type": "boolean"
    },
    "finished": {
      "type": "boolean"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
