{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/player_position_history.json",
  "title": "Player position tenure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "player_uid",
    "position",
    "season",
    "effective_from",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "player_uid": {
      "type": "string"
    },
    "position": {
      "$ref": "../_defs.json#/$defs/position"
    },
    "season": {
      "type": "string"
    },
    "effective_from": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_to": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
