{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/team_identities.json",
  "title": "Team identity mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "team_uid",
    "source_id",
    "source_team_id",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "team_uid": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_team_id": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
