{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-lab.local/schemas/fixtures.json",
  "title": "Fixture current view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_uid",
    "season_id",
    "home_team_uid",
    "away_team_uid",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "properties": {
    "fixture_uid": {
      "type": "string"
    },
    "season_id": {
      "type": "string"
    },
    "gameweek": {
      "type": "integer"
    },
    "home_team_uid": {
      "type": "string"
    },
    "away_team_uid": {
      "type": "string"
    },
    "kickoff_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "status": {
      "type": "string"
    },
    "published_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "observed_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "effective_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "finalised_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "available_at": {
      "$ref": "../_defs.json#/$defs/iso_datetime"
    },
    "provenance": {
      "$ref": "../_defs.json#/$defs/provenance"
    }
  }
}
