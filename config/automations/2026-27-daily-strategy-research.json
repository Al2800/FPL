{
  "schema_version": "1.0",
  "automation_id": "fpl-daily-strategy-research",
  "name": "FPL daily strategy decision",
  "description": "Composer 2.5 primary advisory decision arm: web-search reasoning over the statistical base to recommend 15, chips and captains; host still validates and scores.",
  "status": "recipe_ready_activate_in_cursor_ui",
  "supersedes": "fpl-daily-official-news-research",
  "model": {
    "id": "composer-2.5",
    "display_name": "Composer 2.5",
    "assignment": "required"
  },
  "trigger": {
    "type": "schedule",
    "cron": "0 7 * * *",
    "timezone": "UTC",
    "description": "Daily at 07:00 UTC so the briefing precedes London morning capture review"
  },
  "repository": {
    "scope": "single",
    "repo": "Al2800/FPL",
    "branch": "main"
  },
  "tools": {
    "web_search": true,
    "computer_use": true,
    "pull_request_creation": true,
    "memories": true,
    "send_to_slack": false,
    "mcp": []
  },
  "prompt": {
    "path": "prompts/daily-strategy-research/v1.md",
    "version": "v1"
  },
  "nested_prompts": [
    {
      "role": "official_discovery_lane",
      "path": "prompts/daily-news-research/v1.md"
    }
  ],
  "inputs": {
    "catalogue_path": "control/sources/club-news-catalogue.yaml",
    "discovery_config_path": "config/data_sources/2026-27-news-discovery.json",
    "rules_path": "control/rules/2026-27.yaml",
    "initial_squad_policy_path": "control/policies/initial-squad-2026-27.json",
    "loop_doc_path": "docs/evaluation/2026-27-daily-agent-strategy-loop.md",
    "model_evidence_policy_path": "config/data_sources/2026-27-model-evidence-run.json",
    "model_evidence_schema_path": "control/schemas/evidence/model_evidence_run.json",
    "model_evidence_ingest_script": "scripts/ingest_model_evidence_run.py"
  },
  "outputs": {
    "strategy_briefing_glob": "reports/strategy-research/*.md",
    "search_results_glob": "data/live-shadow/news-discovery/*/search-results.json",
    "discovery_glob": "data/live-shadow/news-discovery/*/news-discovery.json",
    "model_evidence_run_glob": "data/live-shadow/evidence/model-runs/*/model-evidence-run.json",
    "model_evidence_audit_glob": "data/live-shadow/availability/model-runs/*.audit.json",
    "availability_ledger_glob": "data/live-shadow/availability/model-runs/availability-ledger-*.json",
    "commit_briefing": true,
    "commit_raw_discovery": false,
    "commit_model_evidence_run": false,
    "commit_ledger_captures": false,
    "open_draft_pr_for_briefing": true
  },
  "governance": {
    "role": "primary_advisory_decision_arm",
    "community_content_lane": "informs_strategy_decision_with_citations",
    "official_lane": "model_candidates_host_admitted",
    "claim_policy": "model_derived_candidate_host_validated_claim",
    "model_evidence_policy": "model_proposes_host_validates_and_appends",
    "raw_snippet_policy": "never_admit_or_retain",
    "ephemeral_official_url_fetch": "hash_then_discard",
    "html_scrape_collector": "bulk_disabled",
    "phase": "0_1_advisory",
    "deterministic_arms_role": "comparators_and_legality_stress_tests",
    "does_not_replace": [
      "six_gw_live_faithful_horizon_statistical_base",
      "host_rules_validation_and_rescoring",
      "owner_approval_gate"
    ]
  },
  "activation": {
    "cursor_ui": "https://cursor.com/automations",
    "steps": [
      "Create Scheduled automation with cron 0 7 * * * (UTC)",
      "Set model to Composer 2.5",
      "Attach repository Al2800/FPL on branch main",
      "Paste the full text of prompts/daily-strategy-research/v1.md as the automation prompt",
      "Enable computer use / web browsing; enable PR creation; enable memories",
      "Disable or do not also run the narrower news-only automation on the same morning",
      "Save and activate"
    ]
  }
}
