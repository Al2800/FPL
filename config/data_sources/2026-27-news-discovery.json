{
  "schema_version": "1.0",
  "season": "2026-27",
  "daily_schedule": "daily_preseason_and_predeadline_checkpoints",
  "source_preference": ["verified_rss_or_api", "official_domain_search_fallback"],
  "query_template": "site:{official_domain} (injury OR training OR fitness OR \"back in training\" OR \"press conference\" OR \"team news\" OR pre-season OR preseason OR tour)",
  "season_phase": "preseason_before_gw1",
  "season_phase_query_terms": [
    "training",
    "back in training",
    "fitness",
    "tour",
    "pre-season",
    "preseason",
    "Community Shield",
    "press conference",
    "team news"
  ],
  "capture_objective": "fresh_dated_official_first",
  "recency_bias_days": 14,
  "per_club_candidate_cap": 12,
  "per_club_official_cap": 8,
  "per_club_external_cap": 4,
  "watchlist_extra_cap": 10,
  "publication_time_recovery": {
    "enabled": true,
    "priority_clubs": [
      "manchester-city",
      "manchester-united",
      "arsenal",
      "liverpool",
      "chelsea",
      "premier-league"
    ],
    "min_official_pages_to_open_per_priority_club": 3,
    "body_retention": "never"
  },
  "maximum_result_age_hours": 72,
  "maximum_leads_per_source": 12,
  "search_result_policy": "discovery_lead_only_follow_official_original",
  "raw_snippet_policy": "never_admit_or_retain",
  "claim_policy": "model_derived_candidate_host_validated_claim",
  "deduplication": "canonical_official_url",
  "syndication_policy": "reject_non_official_domain",
  "missing_coverage_policy": "degrade_unknown_not_available"
}
